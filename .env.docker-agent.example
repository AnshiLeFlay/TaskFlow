# Docker Desktop development profile for MCP clients running in containers.
# This file contains no private credentials. Compose falls back to the local
# development defaults for settings not listed here.

# One canonical hostname is resolvable both by Windows browsers and containers.
KEYCLOAK_PUBLIC_URL=http://host.docker.internal:8082
KEYCLOAK_ISSUER_URL=http://host.docker.internal:8082/realms/taskflow
MCP_PUBLIC_URL=http://host.docker.internal:8080/mcp
MCP_AUDIENCE=http://host.docker.internal:8080/mcp

# Plain HTTP remains disabled for every other non-loopback hostname.
MCP_INSECURE_HTTP_HOSTS=host.docker.internal

# The browser must start at the same canonical Keycloak URL so the token issuer
# matches the backend verifier and the discovery document.
VITE_KEYCLOAK_URL=http://host.docker.internal:8082

# Native container agents omit Origin. Keep browser origins explicitly scoped.
MCP_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
