# Copy this file to .env before running Docker Compose.
# Required application database settings
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_DB=taskflow
DATABASE_URL=postgres://taskflow:taskflow@postgres:5432/taskflow?sslmode=disable

# Required Keycloak bootstrap and application settings
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_CLIENT_ID=taskflow-web
# Browser-visible issuer. It must match the iss claim in access tokens.
KEYCLOAK_ISSUER_URL=http://localhost:8082/realms/taskflow
# Docker-internal JWKS endpoint used by the backend to validate tokens.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/taskflow/protocol/openid-connect/certs
KEYCLOAK_ADMIN_URL=http://keycloak:8080
KEYCLOAK_REALM=taskflow
KEYCLOAK_DIRECTORY_CLIENT_ID=taskflow-backend
KEYCLOAK_DIRECTORY_CLIENT_SECRET=taskflow-backend-secret
KEYCLOAK_SKIP_AUDIENCE=false

# Backend (optional defaults shown)
HTTP_ADDR=:8080
GRPC_ADDR=:50051
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173
MIGRATIONS_URL=file://migrations
SHUTDOWN_TIMEOUT=10s
# One of: debug, info, warn, error
LOG_LEVEL=info
# Used only by the container/binary healthcheck subcommand.
HEALTHCHECK_URL=http://127.0.0.1:8080/healthz

# Frontend build-time configuration (optional defaults shown)
VITE_API_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/ws
VITE_KEYCLOAK_URL=http://localhost:8082
VITE_KEYCLOAK_REALM=taskflow
VITE_KEYCLOAK_CLIENT_ID=taskflow-web
VITE_BACKEND_PROXY=http://localhost:8080

# E2E (optional; development-only imported users)
E2E_BASE_URL=http://localhost:8081
E2E_ADMIN_USERNAME=alice
E2E_ADMIN_PASSWORD=alice
E2E_WORKERS=1
E2E_HEADLESS=true
